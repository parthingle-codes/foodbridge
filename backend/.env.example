# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://foodbridge:foodbridge123@localhost:5432/foodbridge
DB_HOST=localhost
DB_PORT=5432
DB_NAME=foodbridge
DB_USER=foodbridge
DB_PASSWORD=foodbridge123

# JWT
JWT_SECRET=foodbridge-hackathon-jwt-secret-hacknova2026
JWT_EXPIRES_IN=24h

# OTP
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6
DEMO_OTP=123456

# Matching Engine
MAX_SERVICE_RADIUS_KM=50
WEIGHT_DISTANCE=0.35
WEIGHT_CAPACITY=0.25
WEIGHT_TIME=0.20
WEIGHT_NEED=0.20

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ENABLED=false

# S3 Storage (optional)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=foodbridge-uploads
S3_REGION=us-east-1

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Credits
CREDITS_PER_KG=10
CREDITS_PER_SERVING=5
